# DealFlow360 Backend Environment Configuration Example
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dealflow360
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Frontend CORS Origin
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (Brevo / Transactional Email)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@dealflow360.com
BREVO_SENDER_NAME=DealFlow360

# Google OAuth 2.0 / Google Identity Services
# Client ID obtained from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
